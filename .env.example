# Copy this file to .env for local development and fill in real values.
# On Render, do NOT upload a .env file - set these same two names as
# Environment Variables in the Render dashboard instead.

COC_API_TOKEN=paste_your_token_here
CLAN_TAG=#2PP

# Recommended fix for hosts with non-static outbound IPs (e.g. Render):
# route Clash of Clans API calls through a small proxy box that has one
# fixed IP, so the outbound IP Supercell sees never changes. Whitelist that
# one proxy IP with your API key and you're done - no more token rotation.
# Format: http://username:password@proxy-host:port
# COC_PROXY_URL=http://coctracker:yourpassword@123.45.67.89:8888

# Alternative/fallback: set these two instead of (or alongside) COC_API_TOKEN
# to have the app mint and refresh its own Clash of Clans API key
# automatically whenever the host's outbound IP changes. This is your
# developer.clashofclans.com login, NOT the API token - never commit it.
# If both are set, COC_API_TOKEN above is only used as a last-resort fallback.
# COC_EMAIL=you@example.com
# COC_PASSWORD=yourpassword
# COC_KEY_NAME=clash-of-clans-progress-tracker
